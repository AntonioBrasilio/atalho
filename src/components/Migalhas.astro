---
interface Props {
  itens: { nome: string; url: string }[];
}
const { itens } = Astro.props;
---

<nav class="migalhas" aria-label="Você está em">
  <ol>
    {
      itens.map((it, i) => (
        <li>{i < itens.length - 1 ? <a href={it.url}>{it.nome}</a> : <span aria-current="page">{it.nome}</span>}</li>
      ))
    }
  </ol>
</nav>
