---
import Selo from './Selo.astro';
import { urlResposta, type Resposta } from '../lib/util';
interface Props {
  r: Resposta;
}
const { r } = Astro.props;
---

<a class="card card-r" href={urlResposta(r.data.slug)} data-status={r.data.status}>
  <span class="topo-card">
    <Selo status={r.data.status} curto />
    <svg class="seta" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
      ><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
      ></path></svg
    >
  </span>
  <strong>{r.data.pergunta}</strong>
  <span class="resumo">{r.data.resposta_curta}</span>
</a>

<style>
  .card-r {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    text-decoration: none;
    color: var(--txt);
    padding: 0.85rem 1rem 0.95rem;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      transform 0.12s ease;
  }
  .card-r:hover {
    color: var(--txt);
    border-color: var(--borda-2);
    background: var(--bg-3);
  }
  .card-r:active {
    transform: scale(0.99);
  }
  .topo-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .seta {
    color: var(--cinza);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .card-r:hover .seta {
    color: var(--rosa);
    transform: translateX(3px);
  }
  strong {
    font-size: 1.04rem;
    line-height: 1.35;
  }
  .resumo {
    color: var(--txt-2);
    font-size: 0.92rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
