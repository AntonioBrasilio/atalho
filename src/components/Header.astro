---
import { config } from '../config';
const atual = Astro.url.pathname;
const links = [
  { href: '/gta6/', nome: 'GTA 6' },
  { href: '/gta6/codigos/', nome: 'Códigos' },
  { href: '/gta6/trofeus/', nome: 'Troféus' },
  { href: '/comprar/', nome: 'Comprar' },
  { href: '/comunidade/', nome: 'Comunidade' },
  ...(config.produto.ativo ? [{ href: '/guia-platina/', nome: 'Guia Platina' }] : []),
];
const fixas = ['/gta6/codigos/', '/gta6/trofeus/'];
const ehAtual = (href: string) =>
  href === '/gta6/' ? atual.startsWith('/gta6/') && !fixas.some((f) => atual.startsWith(f)) : atual.startsWith(href);
---

<header class="topo">
  <div class="topo-in">
    <a href="/" class="logo" aria-label={`${config.siteName}: início`}>
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff3d8b"></stop>
            <stop offset=".55" stop-color="#ff9a3c"></stop>
            <stop offset="1" stop-color="#2de2e6"></stop>
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="8" fill="#1d1929"></rect>
        <path d="M18.5 4 8 18h7l-1.5 10L24 14h-7l1.5-10Z" fill="url(#lg)"></path>
      </svg>
      <span>{config.siteName}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={ehAtual(l.href) ? 'page' : undefined}>
                {l.nome}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--borda);
    background: #0d0b14f2;
  }
  .topo-in {
    max-width: var(--max);
    height: var(--topo);
    margin: 0 auto;
    padding: 0 0 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--txt);
    font-family: var(--display);
    font-size: 1.45rem;
    letter-spacing: 0.03em;
  }
  nav {
    margin-left: auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 24px), transparent);
    mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 24px), transparent);
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  ul {
    list-style: none;
    display: flex;
    margin: 0;
    padding: 0 var(--gutter) 0 0.6rem;
  }
  li + li {
    margin: 0;
  }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: var(--topo);
    padding: 0 0.6rem;
    color: var(--txt-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.94rem;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--txt);
  }
  nav a[aria-current='page'] {
    color: var(--txt);
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--grad);
  }
  @media (min-width: 720px) {
    .topo-in {
      padding-right: var(--gutter);
    }
    nav {
      -webkit-mask-image: none;
      mask-image: none;
    }
    ul {
      padding-right: 0;
    }
  }
</style>
