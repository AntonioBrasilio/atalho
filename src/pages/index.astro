---
import Base from '../layouts/Base.astro';
import Busca from '../components/Busca.astro';
import CardResposta from '../components/CardResposta.astro';
import WhatsCta from '../components/WhatsCta.astro';
import { config, jogos } from '../config';
import { respostasGta6 } from '../lib/dados';
import { absUrl, urlResposta } from '../lib/util';

const todas = await respostasGta6();
const novas = todas.slice(0, 8);
const confirmadas = todas.filter((r) => r.data.status === 'confirmado').length;

/** Atalhos para as dúvidas mais procuradas (troque à vontade). */
const populares = [
  ['Cheats', 'gta-6-tem-codigos-cheats'],
  ['Código de dinheiro', 'codigo-dinheiro-gta-6'],
  ['Guardar carro', 'como-guardar-carro-gta-6'],
  ['Ganhar dinheiro', 'como-ganhar-dinheiro-rapido-gta-6'],
  ['Fugir da polícia', 'como-baixar-estrelas-de-procurado-gta-6'],
  ['Salvar o jogo', 'como-salvar-o-jogo-gta-6'],
  ['Garagens', 'garagens-gta-6-precos'],
  ['Carros raros', 'carros-raros-gta-6'],
  ['Armas', 'onde-comprar-armas-gta-6'],
].filter(([, s]) => todas.some((r) => r.data.slug === s));

const ldSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.siteName,
  url: absUrl('/'),
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: absUrl('/') + '?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title={`${config.siteName}: respostas rápidas de games`} tituloCru jsonld={[ldSite]}>
  <section class="hero">
    <h1><span class="grad-txt">Travou no jogo?</span> A resposta em 1 linha</h1>
    <p class="sub">Cheats, carros, dinheiro, polícia e missões. A resposta aparece no topo, com selo de confiabilidade.</p>
    <Busca id="busca-home" />
    <p class="pop-tit">Mais buscadas</p>
    <ul class="chips" aria-label="Mais buscadas">
      {
        populares.map(([nome, slug]) => (
          <li>
            <a class="chip" href={urlResposta(slug)}>
              {nome}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="stats">
      <span><strong>{todas.length}</strong> respostas</span>
      <span><strong class="ok">{confirmadas}</strong> confirmadas</span>
      <span>Atualizado todo dia</span>
    </p>
  </section>

  <div class="secao-topo">
    <h2>Respostas novas</h2>
    <a href="/gta6/">Ver todas →</a>
  </div>
  <ul class="lista-cards duas">
    {
      novas.map((r) => (
        <li>
          <CardResposta r={r} />
        </li>
      ))
    }
  </ul>

  <h2>Jogos</h2>
  <ul class="jogos">
    {
      jogos.map((j) => (
        <li>
          <a class="card jogo" href={j.url}>
            <span class="jogo-nome">{j.nome}</span>
            <span class="muted">{j.descricao}</span>
            <span class="qtd">{todas.length} respostas →</span>
          </a>
        </li>
      ))
    }
    <li>
      <div class="card jogo breve"><span class="jogo-nome">Em breve</span><span class="muted">Outros jogos.</span></div>
    </li>
  </ul>

  <WhatsCta origem="home" />
</Base>

<style>
  .hero {
    padding-top: 0.6rem;
  }
  .hero h1 {
    font-size: clamp(2.05rem, 9vw, 3.3rem);
    margin-bottom: 0.5rem;
  }
  .sub {
    color: var(--txt-2);
    font-size: 1.02rem;
    margin-bottom: 0.4rem;
  }
  .pop-tit {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--txt-2);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    font-size: 0.9rem;
    color: var(--txt-2);
  }
  .stats strong {
    color: var(--txt);
  }
  .stats .ok {
    color: var(--verde);
  }
  .jogos {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.7rem;
  }
  .jogos li + li {
    margin: 0;
  }
  .jogo {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    text-decoration: none;
    color: var(--txt);
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 2px solid transparent;
  }
  .jogo:hover {
    color: var(--txt);
  }
  .jogo-nome {
    font-family: var(--display);
    font-size: 1.8rem;
  }
  .qtd {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--laranja);
  }
  .breve {
    background: var(--bg-2);
    border: 1px dashed var(--borda);
    opacity: 0.8;
  }
</style>
