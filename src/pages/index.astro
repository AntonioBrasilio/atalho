---
import Base from '../layouts/Base.astro';
import Busca from '../components/Busca.astro';
import CardResposta from '../components/CardResposta.astro';
import WhatsCta from '../components/WhatsCta.astro';
import { config, jogos } from '../config';
import { respostasGta6 } from '../lib/dados';
import { absUrl } from '../lib/util';

const todas = await respostasGta6();
const novas = todas.slice(0, 8);

const ldSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.siteName,
  url: absUrl('/'),
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: absUrl('/') + '?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title={`${config.siteName}: respostas rápidas de games`} tituloCru jsonld={[ldSite]}>
  <section class="hero">
    <h1><span class="grad-txt">Sua dúvida de game</span> respondida em 1 linha</h1>
    <p class="muted">Digite o que você quer saber. A resposta aparece no topo, com selo de confiabilidade.</p>
    <Busca id="busca-home" />
  </section>

  <h2>Respostas novas hoje</h2>
  <ul class="lista-cards">
    {
      novas.map((r) => (
        <li>
          <CardResposta r={r} />
        </li>
      ))
    }
  </ul>
  <p><a href="/gta6/">Ver todas as respostas de GTA 6 →</a></p>

  <h2>Jogos</h2>
  <ul class="jogos">
    {
      jogos.map((j) => (
        <li>
          <a class="card jogo" href={j.url}>
            <span class="jogo-nome">{j.nome}</span>
            <span class="muted">{j.descricao}</span>
            <span class="muted qtd">{todas.length} respostas</span>
          </a>
        </li>
      ))
    }
    <li><div class="card jogo breve"><span class="jogo-nome">Em breve</span><span class="muted">Outros jogos.</span></div></li>
  </ul>

  <WhatsCta origem="home" />
</Base>

<style>
  .hero {
    padding: 0.5rem 0 0.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 8.5vw, 3rem);
  }
  .jogos {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.7rem;
  }
  .jogos li + li {
    margin: 0;
  }
  .jogo {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    text-decoration: none;
    color: var(--txt);
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 2px solid transparent;
  }
  .jogo:hover {
    color: var(--txt);
  }
  .jogo-nome {
    font-family: var(--display);
    font-size: 1.8rem;
  }
  .qtd {
    font-size: 0.85rem;
  }
  .breve {
    background: var(--bg-2);
    border: 1px dashed var(--borda);
    opacity: 0.8;
  }
</style>
