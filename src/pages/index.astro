---
import Base from '../layouts/Base.astro';
import Busca from '../components/Busca.astro';
import CardResposta from '../components/CardResposta.astro';
import RespostaPronta from '../components/RespostaPronta.astro';
import Sequencia from '../components/Sequencia.astro';
import Selo from '../components/Selo.astro';
import WhatsCta from '../components/WhatsCta.astro';
import { config, jogos } from '../config';
import { CATEGORIAS } from '../content.config';
import { respostasGta6 } from '../lib/dados';
import { CATEGORIA_INFO, absUrl, formatarData, urlCategoria, urlResposta } from '../lib/util';

const todas = await respostasGta6();
const porSlug = new Map(todas.map((r) => [r.data.slug, r]));
const ultima = todas[0]?.data.atualizado_em;

/** Perguntas de exemplo: ao tocar, a resposta aparece na própria busca. */
const exemplos = [
  'como guardar meu carro',
  'código de dinheiro',
  'fugir da polícia',
  'munição infinita',
  'onde tem carro raro',
  'como salvar o jogo',
];

/** Respostas prontas na home (a resposta já aparece inteira). Troque à vontade. */
const prontas = (
  [
    ['🚗', 'como-guardar-carro-gta-6'],
    ['🚓', 'como-baixar-estrelas-de-procurado-gta-6'],
    ['💰', 'como-ganhar-dinheiro-rapido-gta-6'],
    ['💾', 'como-salvar-o-jogo-gta-6'],
    ['🏠', 'garagens-gta-6-precos'],
    ['⭐', 'carros-raros-gta-6'],
    ['🔫', 'onde-comprar-armas-gta-6'],
    ['☠️', 'como-nao-perder-dinheiro-gta-6'],
  ] as const
)
  .map(([icone, slug]) => ({ icone, r: porSlug.get(slug) }))
  .filter((x) => x.r);

const cheatDinheiro = porSlug.get('codigo-dinheiro-gta-6');

const ordemCats = ['codigos', 'veiculos', 'dinheiro', 'policia', 'armas', 'missoes', 'mecanicas', 'segredos', 'erros', 'trofeus', 'mapa', 'personagens'] as const;
const cats = ordemCats
  .filter((c) => CATEGORIAS.includes(c))
  .map((c) => ({ id: c, ...CATEGORIA_INFO[c], n: todas.filter((r) => r.data.categoria === c).length }))
  .filter((c) => c.n > 0);

const novas = todas.slice(0, 4);

const ldSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.siteName,
  url: absUrl('/'),
  inLanguage: 'pt-BR',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: absUrl('/') + '?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title={`${config.siteName}: respostas rápidas de GTA 6`} tituloCru jsonld={[ldSite]}>
  <section class="hero">
    <p class="badge">
      <span class="pulso" aria-hidden="true"></span> GTA 6 · {todas.length} respostas
      {ultima && <> · atualizado {formatarData(ultima)}</>}
    </p>
    <h1>Travou no <span class="grad-txt nowrap">GTA 6?</span> Pergunte.</h1>
    <p class="sub">Escreva do seu jeito, até com erro. <strong>A resposta aparece aqui mesmo</strong>, sem abrir outra página.</p>
    <Busca id="busca-home" inline />
    <div class="exemplos">
      <span class="ex-tit">Toque para testar:</span>
      <ul class="chips" aria-label="Perguntas de exemplo">
        {
          exemplos.map((q) => (
            <li>
              <a class="chip" href={`/?q=${encodeURIComponent(q)}`} data-q={q}>{q}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="tit-prontas">
    <h2 id="tit-prontas"><span aria-hidden="true">⚡</span> Respostas prontas</h2>
    <p class="muted intro">As dúvidas de quem está jogando agora, já respondidas.</p>
    <ul class="grade-prontas">
      {
        prontas.map(({ icone, r }) => (
          <li>
            <RespostaPronta r={r!} icone={icone} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    cheatDinheiro?.data.codigo && (
      <section class="cheat-box" aria-labelledby="tit-cheat">
        <div class="cb-topo">
          <h2 id="tit-cheat"><span aria-hidden="true">🎮</span> Cheat de dinheiro</h2>
          <Selo status={cheatDinheiro.data.status} curto />
        </div>
        <p class="cb-efeito">{cheatDinheiro.data.codigo.efeito}</p>
        <Sequencia seq={cheatDinheiro.data.codigo.sequencia} grande />
        <ol class="passos">
          <li><span class="num">1</span> Aperte <kbd>↑</kbd> para abrir o celular</li>
          <li><span class="num">2</span> Segure <kbd>L1</kbd>+<kbd>R1</kbd> ou <kbd>LB</kbd>+<kbd>RB</kbd></li>
          <li><span class="num">3</span> Digite a sequência no direcional</li>
        </ol>
        <p class="cb-alerta">⚠️ Com cheat ativo o jogo não salva e não libera troféus.</p>
        <div class="cb-links">
          <a class="btn btn-sm" href="/gta6/codigos/">Todos os códigos</a>
          <a class="btn btn-sec btn-sm" href={urlResposta('codigo-dinheiro-gta-6')}>Detalhes</a>
        </div>
      </section>
    )
  }

  <section aria-labelledby="tit-cats">
    <h2 id="tit-cats">Escolha o assunto</h2>
    <ul class="grade-cats">
      {
        cats.map((c) => (
          <li>
            <a class="cat-tile" href={c.paginaFixa ?? urlCategoria(c.id)}>
              <span class="ic" aria-hidden="true">{c.icone}</span>
              <span class="nome">{c.nome}</span>
              <span class="n">{c.n}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <aside class="legenda" aria-label="O que significam os selos">
    <span><strong class="ok">✅ Confirmado</strong> oficial ou testado</span>
    <span><strong class="nc-t">❓ Não confirmado</strong> sites menores e relatos</span>
    <span><strong>⏳ Testando</strong> sem resposta ainda</span>
  </aside>

  <div class="secao-topo">
    <h2>Acabou de entrar</h2>
    <a href="/gta6/">Ver todas →</a>
  </div>
  <ul class="lista-cards duas">
    {
      novas.map((r) => (
        <li>
          <CardResposta r={r} />
        </li>
      ))
    }
  </ul>

  <WhatsCta origem="home" />

  <p class="outros muted">
    Jogos: {jogos.map((j) => <a href={j.url}>{j.nome}</a>)} · outros em breve.
  </p>
</Base>

<style>
  .hero {
    padding-top: 0.4rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.3rem 0 0.2rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--borda-2);
    background: var(--bg-2);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--txt-2);
  }
  .pulso {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--verde);
    box-shadow: 0 0 0 0 #3ddc8499;
    animation: pulso 2s infinite;
  }
  @keyframes pulso {
    70% {
      box-shadow: 0 0 0 8px #3ddc8400;
    }
    100% {
      box-shadow: 0 0 0 0 #3ddc8400;
    }
  }
  .hero h1 {
    font-size: clamp(2.2rem, 10vw, 3.6rem);
    margin: 0.4rem 0 0.4rem;
  }
  .nowrap {
    white-space: nowrap;
  }
  .sub {
    color: var(--txt-2);
    font-size: 1.02rem;
    margin-bottom: 0.3rem;
  }
  .sub strong {
    color: var(--txt);
  }
  .exemplos {
    margin-top: -0.3rem;
  }
  .ex-tit {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--txt-2);
  }
  .exemplos .chip::before {
    content: '“';
    color: var(--rosa);
  }
  .exemplos .chip::after {
    content: '”';
    color: var(--rosa);
  }
  .intro {
    margin-top: -0.4rem;
  }
  .grade-prontas {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 0.65rem;
  }
  .grade-prontas li + li {
    margin: 0;
  }
  @media (min-width: 720px) {
    .grade-prontas {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cheat-box {
    margin: 1.8rem 0;
    padding: 1.1rem 1.1rem 1.2rem;
    border-radius: var(--raio);
    background:
      radial-gradient(30rem 12rem at 100% 0%, #ff9a3c1f, transparent 70%),
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 2px solid transparent;
  }
  .cb-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .cb-topo h2 {
    margin: 0;
  }
  .cb-efeito {
    margin: 0.4rem 0 0.7rem;
    font-weight: 700;
    color: var(--laranja);
  }
  .passos {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0.6rem;
    display: grid;
    gap: 0.45rem;
  }
  .passos li {
    position: relative;
    margin: 0;
    padding-left: 2.2rem;
    min-height: 1.6rem;
    font-size: 0.95rem;
  }
  .num {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--grad);
    color: #160b12;
    font-weight: 800;
    font-size: 0.85rem;
  }
  kbd {
    display: inline-block;
    min-width: 1.7em;
    padding: 0 0.35em;
    border: 1px solid var(--borda-2);
    border-bottom-width: 3px;
    border-radius: 6px;
    background: var(--bg-3);
    font: 700 0.88em/1.5 system-ui, sans-serif;
    text-align: center;
  }
  .cb-alerta {
    font-size: 0.88rem;
    color: var(--txt-2);
    margin-bottom: 0.8rem;
  }
  .cb-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .grade-cats {
    list-style: none;
    padding: 0;
    margin: 0 0 1.2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  @media (min-width: 720px) {
    .grade-cats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .grade-cats li + li {
    margin: 0;
  }
  .cat-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 84px;
    padding: 0.6rem 0.3rem;
    border-radius: 14px;
    background: var(--bg-2);
    border: 1px solid var(--borda);
    color: var(--txt);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    text-align: center;
    transition:
      border-color 0.15s ease,
      transform 0.12s ease;
  }
  .cat-tile:hover {
    color: var(--txt);
    border-color: var(--rosa);
  }
  .cat-tile:active {
    transform: scale(0.97);
  }
  .cat-tile .ic {
    font-size: 1.6rem;
    line-height: 1;
  }
  .cat-tile .n {
    position: absolute;
    top: 0.35rem;
    right: 0.5rem;
    font-size: 0.72rem;
    color: var(--laranja);
  }
  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    background: var(--bg-2);
    border: 1px dashed var(--borda-2);
    font-size: 0.86rem;
    color: var(--txt-2);
  }
  .legenda strong {
    color: var(--txt);
  }
  .legenda .ok {
    color: var(--verde);
  }
  .legenda .nc-t {
    color: var(--amarelo);
  }
  .outros {
    font-size: 0.9rem;
    text-align: center;
  }
</style>
