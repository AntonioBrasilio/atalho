---
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Busca from '../../../components/Busca.astro';
import Migalhas from '../../../components/Migalhas.astro';
import Selo from '../../../components/Selo.astro';
import Anuncio from '../../../components/Anuncio.astro';
import CaixaAfiliado from '../../../components/CaixaAfiliado.astro';
import CardResposta from '../../../components/CardResposta.astro';
import Sequencia from '../../../components/Sequencia.astro';
import WhatsCta from '../../../components/WhatsCta.astro';
import { config } from '../../../config';
import { respostasGta6 } from '../../../lib/dados';
import {
  CATEGORIA_INFO,
  STATUS_INFO,
  absUrl,
  formatarData,
  ldBreadcrumb,
  ldFaq,
  relacionadas,
  urlCategoria,
  urlCorrecao,
  urlResposta,
  type Resposta,
} from '../../../lib/util';

export async function getStaticPaths() {
  const todas = await respostasGta6();
  return todas.map((r) => ({ params: { slug: r.data.slug }, props: { r, todas } }));
}

interface Props {
  r: Resposta;
  todas: Resposta[];
}
const { r, todas } = Astro.props;
const d = r.data;
const { Content } = await render(r);
const cat = CATEGORIA_INFO[d.categoria];
const st = STATUS_INFO[d.status];
const guia = d.afiliado_contextual ? await getEntry('guias', d.afiliado_contextual) : undefined;
const rel = relacionadas(r, todas);
const urlAbs = absUrl(urlResposta(d.slug));

const migalhas = [
  { nome: 'Início', url: '/' },
  { nome: 'GTA 6', url: '/gta6/' },
  { nome: cat.nome, url: cat.paginaFixa ?? urlCategoria(d.categoria) },
];
const jsonld = [
  ldFaq([{ pergunta: d.pergunta, resposta: d.resposta_curta }]),
  ldBreadcrumb([...migalhas, { nome: d.pergunta, url: urlResposta(d.slug) }]),
];
const fontes = [
  ...(d.fonte_url ? [{ nome: d.fonte_nome ?? new URL(d.fonte_url).hostname, url: d.fonte_url }] : []),
  ...d.fontes_extras,
];
const explicacao = {
  confirmado: 'Informação oficial ou testada no jogo.',
  vazamento: 'Não conseguimos confirmar: veio de sites menores, vazamentos ou relatos de jogadores e pode estar errado.',
  testando: 'Ainda não temos uma resposta verificada. Estamos testando.',
}[d.status];
const textoCompartilhar = `${d.pergunta}\n${d.resposta_curta}`;
---

<Base
  title={`${d.pergunta} (resposta rápida) | ${config.siteName}`}
  tituloCru
  description={d.resposta_curta}
  ogType="article"
  jsonld={jsonld}
>
  <Busca compacta id="busca-r" />
  <Migalhas itens={migalhas} />

  <article>
    <h1>{d.pergunta}</h1>

    <section class:list={['resposta', `st-${st.classe}`]} aria-labelledby="rotulo-resposta">
      <p class="rotulo" id="rotulo-resposta"><span aria-hidden="true">⚡</span> Resposta rápida</p>
      <p class="texto">{d.resposta_curta}</p>
      {
        d.codigo && (
          <div class="seq-box">
            <Sequencia seq={d.codigo.sequencia} grande />
            <p class="seq-como">Abra o celular (<kbd>↑</kbd>), segure <kbd>L1</kbd>+<kbd>R1</kbd> ou <kbd>LB</kbd>+<kbd>RB</kbd> e digite.</p>
          </div>
        )
      }
      <div class="rodape-resposta">
        <Selo status={d.status} />
        <span class="data">
          Atualizado em <time datetime={d.atualizado_em.toISOString()}>{formatarData(d.atualizado_em)}</time>
        </span>
      </div>
      <p class="explica">{explicacao}</p>
      <div class="acoes" data-acoes data-url={urlAbs} data-texto={textoCompartilhar} data-slug={d.slug}>
        <button type="button" class="btn btn-sec btn-sm" data-compartilhar>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          Compartilhar
        </button>
        <button type="button" class="btn btn-sec btn-sm" data-copiar>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
            ><rect x="9" y="9" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"
            ></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" fill="none" stroke="currentColor" stroke-width="2"
            ></path></svg
          >
          <span data-copiar-txt>Copiar</span>
        </button>
      </div>
    </section>

    <Anuncio posicao="top" />

    <h2 class="h-detalhes">Detalhes</h2>
    <div class="prosa">
      <Content />
    </div>

    {
      fontes.length > 0 && (
        <div class="fontes">
          <p class="fontes-tit">{fontes.length > 1 ? 'Fontes' : 'Fonte'}</p>
          <ul>
            {fontes.map((f) => (
              <li>
                <a href={f.url} target="_blank" rel="nofollow noopener">
                  {f.nome}
                  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="feedback" data-feedback data-slug={d.slug}>
      <p class="fb-pergunta">Essa resposta te ajudou?</p>
      <div class="fb-botoes">
        <button type="button" class="chip" data-voto="sim">👍 Sim</button>
        <button type="button" class="chip" data-voto="nao">👎 Não</button>
      </div>
      <p class="fb-obrigado" role="status" hidden>Valeu pelo retorno!</p>
      <p class="fb-corrigir" hidden>
        <a href={urlCorrecao(d.slug)} target="_blank" rel="noopener" data-track="correction_click" data-track-slug={d.slug}>
          Conta pra gente o que faltou →
        </a>
      </p>
    </div>
  </article>

  {guia && <CaixaAfiliado guia={guia} />}

  {
    rel.length > 0 && (
      <section>
        <h2>Perguntas relacionadas</h2>
        <ul class="lista-cards">
          {rel.map((x) => (
            <li>
              <CardResposta r={x} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <WhatsCta origem="resposta" />

  <Anuncio posicao="bottom" />

  <p class="correcao">
    <a href={urlCorrecao(d.slug)} target="_blank" rel="noopener" data-track="correction_click" data-track-slug={d.slug}>
      Achou algo errado ou descobriu algo novo? Envie
    </a>
  </p>
</Base>

<script>
  const acoes = document.querySelector<HTMLElement>('[data-acoes]');
  if (acoes) {
    const { url = location.href, texto = document.title, slug = '' } = acoes.dataset;
    const btnCompart = acoes.querySelector<HTMLButtonElement>('[data-compartilhar]')!;
    const btnCopiar = acoes.querySelector<HTMLButtonElement>('[data-copiar]')!;
    const rotuloCopiar = acoes.querySelector<HTMLElement>('[data-copiar-txt]')!;

    const copiar = async (conteudo: string) => {
      try {
        await navigator.clipboard.writeText(conteudo);
        rotuloCopiar.textContent = 'Copiado!';
        setTimeout(() => (rotuloCopiar.textContent = 'Copiar'), 1800);
      } catch {
        prompt('Copie o texto:', conteudo);
      }
    };

    btnCopiar.addEventListener('click', () => {
      copiar(`${texto}\n${url}`);
      window.atalhoTrack?.('copy_answer', { slug });
    });

    const temShare = 'share' in navigator;
    btnCompart.addEventListener('click', async () => {
      window.atalhoTrack?.('share', { slug, method: temShare ? 'native' : 'whatsapp' });
      if (temShare) {
        try {
          await navigator.share({ title: document.title, text: texto, url });
        } catch {
          /* cancelado */
        }
      } else {
        window.open(`https://wa.me/?text=${encodeURIComponent(`${texto}\n${url}`)}`, '_blank', 'noopener');
      }
    });
  }

  const fb = document.querySelector<HTMLElement>('[data-feedback]');
  fb?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-voto]');
    if (!btn) return;
    const voto = btn.dataset.voto!;
    window.atalhoTrack?.('feedback', { slug: fb.dataset.slug || '', voto });
    fb.querySelector('.fb-botoes')!.setAttribute('hidden', '');
    fb.querySelector<HTMLElement>('.fb-obrigado')!.hidden = false;
    if (voto === 'nao') fb.querySelector<HTMLElement>('.fb-corrigir')!.hidden = false;
  });
</script>

<style>
  h1 {
    margin-bottom: 0.85rem;
  }
  .resposta {
    --cor: var(--verde);
    position: relative;
    background:
      linear-gradient(var(--bg-2), var(--bg-2)) padding-box,
      var(--grad) border-box;
    border: 2px solid transparent;
    border-radius: 20px;
    padding: 1rem 1.1rem 1.05rem;
    box-shadow: 0 18px 50px -24px #ff3d8b55;
  }
  .st-leak {
    --cor: var(--amarelo);
  }
  .st-test {
    --cor: var(--cinza);
  }
  .rotulo {
    margin: 0 0 0.35rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--laranja);
  }
  .texto {
    margin: 0;
    font-size: clamp(1.18rem, 4.6vw, 1.42rem);
    line-height: 1.42;
    font-weight: 650;
    color: #fff;
  }
  .seq-box {
    margin-top: 0.8rem;
  }
  .seq-como {
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
    color: var(--txt-2);
  }
  .seq-como kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 0 0.3em;
    border: 1px solid var(--borda-2);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--bg-3);
    font: 700 0.9em/1.45 system-ui, sans-serif;
    text-align: center;
    color: var(--txt);
  }
  .rodape-resposta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--borda);
  }
  .data {
    font-size: 0.86rem;
    color: var(--txt-2);
  }
  .explica {
    margin: 0.4rem 0 0;
    font-size: 0.84rem;
    color: var(--txt-2);
  }
  .acoes {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .acoes .btn {
    flex: 1;
  }
  .h-detalhes {
    margin-top: 1.6rem;
  }
  .fontes {
    margin: 1.4rem 0 0;
    padding: 0.8rem 1rem;
    background: var(--bg-2);
    border: 1px solid var(--borda);
    border-radius: 14px;
  }
  .fontes-tit {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--txt-2);
  }
  .fontes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
  }
  .fontes li + li {
    margin: 0;
  }
  .fontes a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    font-size: 0.95rem;
  }
  .feedback {
    margin: 1.4rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .fb-pergunta {
    margin: 0;
    font-weight: 700;
  }
  .fb-botoes {
    display: flex;
    gap: 0.5rem;
  }
  .fb-obrigado,
  .fb-corrigir {
    margin: 0;
  }
  .fb-corrigir a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .correcao a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
